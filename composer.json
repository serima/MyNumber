{
  "name": "serima/mynumber",
  "description": "Japanese MyNumber (Individual Number / Corporate Number) verifier",
  "license": "MIT",
  "keywords": [
    "mynumber",
    "my-number",
    "individual-number",
    "corporate-number",
    "validation",
    "japan"
  ],
  "authors": [
    {
      "name": "Ryo Shibayama",
      "email": "j02521@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Serima\\MyNumber\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Serima\\MyNumber\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
